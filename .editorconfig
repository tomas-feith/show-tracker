root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx}]
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

# PowerShell 5.1 misreads BOM-less UTF-8 as cp1252.
[*.ps1]
end_of_line = crlf
charset = utf-8-bom
