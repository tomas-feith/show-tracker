<?xml version="1.0" encoding="utf-8"?>
<!--
    A television: the app is about knowing when the next season lands.

    Drawn inside the central 72x72 safe zone of the 108x108 adaptive-icon canvas, so no
    part of it is clipped by a round, squircle or squared mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Aerial -->
    <path
        android:pathData="M38,24 L54,40 M70,24 L54,40"
        android:strokeColor="#4F8DF7"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Screen -->
    <path
        android:pathData="M26,40 L82,40 A6,6 0 0,1 88,46 L88,76 A6,6 0 0,1 82,82 L26,82 A6,6 0 0,1 20,76 L20,46 A6,6 0 0,1 26,40 Z"
        android:fillColor="#4F8DF7" />

    <!-- Play mark, punched out of the screen in the background colour -->
    <path
        android:pathData="M48,52 L66,61 L48,70 Z"
        android:fillColor="#0E1116" />
</vector>
