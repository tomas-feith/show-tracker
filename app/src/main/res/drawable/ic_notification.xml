<?xml version="1.0" encoding="utf-8"?>
<!--
    Status bar icon. Android draws it as a silhouette from the alpha channel alone, so it is
    a single flat white shape: any colour or interior detail would be discarded, and a
    filled-in screen would come out as a featureless block.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Aerial -->
    <path
        android:pathData="M8,3 L12,7 M16,3 L12,7"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />

    <!-- Screen outline, left hollow so the shape reads at 24dp -->
    <path
        android:pathData="M4,8 L20,8 A1.5,1.5 0 0,1 21.5,9.5 L21.5,19 A1.5,1.5 0 0,1 20,20.5 L4,20.5 A1.5,1.5 0 0,1 2.5,19 L2.5,9.5 A1.5,1.5 0 0,1 4,8 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000" />

    <!-- Play mark -->
    <path
        android:pathData="M10.5,11.5 L15,14.25 L10.5,17 Z"
        android:fillColor="#FFFFFF" />
</vector>
